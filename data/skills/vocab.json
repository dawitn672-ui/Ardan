    "stat": 4,
    "perk": 1, "perkLegacy": 0,
    "trigger": 0.5, "triggerRare": 0.25
  },
  "costNote": "A perk effect that carries a release row (legacy) costs nothing: it continues the release's knack so A.perkSum is the same at the switch (§7); step 6 prices it as a real effect.",
  "triggers": ["win", "wound", "wounded", "dawn", "outnumbered", "home", "parried", "rout", "attacked_first", "ambushed", "battle_start", "duel_start", "near_death", "lose", "siege", "night", "sea_storm", "feast", "prayer"],
  "rareTriggers": ["dawn", "home", "outnumbered", "ambushed", "near_death", "sea_storm"],
