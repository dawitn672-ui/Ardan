  "culturePattern": "^CUL-[0-9]{2}$",
  "faithPattern": "^REL-[0-9]{2}$",
  "housePattern": "^(\\{house\\}|H-[A-Za-z0-9-]+)$",
  "talents": ["F", "E", "D", "C", "B", "A", "S", "SSS"],
  "checkTags": ["bargain", "court", "night", "estate", "supply", "sea", "wild", "town", "law", "letters", "lie", "lock", "weather", "beast", "horse", "healing", "song", "fear"],
  "effects": {
    "stat": { "fields": ["stat", "v"] },
    "edge": { "fields": ["tag", "v"] },
    "fight": { "fields": ["tag", "part", "v"], "parts": ["atk", "def", "burst", "adapt"] },
    "blunder": { "fields": ["tag", "v"] },
    "surge": { "fields": ["tag", "v"] },
    "aura": { "fields": ["of", "scale", "v"], "of": ["morale", "discipline", "speed", "supply"], "scales": ["squad", "company", "army"] },
    "trigger": { "fields": ["on", "do"] },
    "active": { "fields": ["name", "do"] },
    "economy": { "fields": ["of", "v"], "of": ["income", "upkeep", "yield", "train"] },
    "social": { "fields": ["group", "v"] },
    "resist": { "fields": ["of", "v"], "of": ["wounds", "poison", "fear", "illness", "mind"] },
    "unlock": { "fields": ["what"], "kinds": ["activity", "choice", "tactic", "title", "order", "teach"] },
    "growth": { "fields": ["tag", "v"] },
    "perk": { "fields": ["key"] }
  },
  "costs": {
    "edgeNarrow": 1, "edgeFamily": 2, "edgeGroup": 4,
    "fightOne": 2, "fightAll": 4,
    "blunderSurge": 3,
    "aura": { "squad": 3, "company": 6, "army": 12 },
    "resist": 2, "resistHard": 3, "resistHardOf": ["fear", "mind"],
