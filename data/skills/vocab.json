{
  "about": "Skills rebuild (docs/design/skills-v2.md §2.3-§2.7, §15): the fixed vocabulary every skill is written in, its costs and caps. tools/lint-skills.mjs validates data/skills/ against it; src/people/engine/skills2.js reads it. Costs are tuned by the balance harness, never by feel.",
  "ranks": ["D", "C", "B", "A", "S", "SS", "SSS", "X"],
  "rankNote": "D to SSS are the ranks of the owner's order 82; X stands above SSS for the skills of the few legends (no gods as beings, order 83).",
  "perLevel": { "D": 1, "C": 2, "B": 4, "A": 8, "S": 16, "SS": 32, "SSS": 64, "X": 128 },
  "maxLevel": 10,
  "rarities": ["common", "uncommon", "rare", "unique", "legendary"],
  "rarityBonus": { "common": 0, "uncommon": 0, "rare": 0, "unique": 0.25, "legendary": 0.5 },
  "kinds": ["passive", "active", "reaction", "aura", "blessing", "flaw"],
  "groups": ["arms", "body", "war", "land", "sea", "crafts", "trade", "letters", "faith", "court", "shadow",
    "mind", "command", "social", "wilds", "governance", "house", "flaw", "racial", "magic", "monster", "spirit"],
  "census": ["count", "one", "age"],
  "teach": ["any", "school", "house", "faith", "culture", "none"],
  "vias": ["practice", "teacher", "school", "bloodline", "culture", "faith", "deed", "event", "office", "item", "evolve", "merge", "awaken", "trauma", "birth", "title"],
